 #include <mcpelauncher/linker.h>
 #include <thread>

+
+
+#if defined(__APPLE__) && defined(__aarch64__)
+#include <sys/ucontext.h>
+#include <unistd.h>
+// Diagnostic-only: write the actual fault context before the legacy unwinder.
+static void faultHex(const char* key, unsigned long long value) {
+    char line[96]; unsigned n = 0;
+    while (*key) line[n++] = *key++;
+    line[n++] = '='; line[n++] = '0'; line[n++] = 'x';
+    for (int shift = 60; shift >= 0; shift -= 4)
+        line[n++] = "0123456789abcdef"[(value >> shift) & 15];
+    line[n++] = '\n';
+    write(STDERR_FILENO, line, n);
+}
+static void captureArmFault(int signal, siginfo_t* info, void* context) {
+    auto* uc = static_cast<ucontext_t*>(context);
+    auto& state = uc->uc_mcontext->__ss;
+    faultHex("FAULT_PC", state.__pc);
+    faultHex("FAULT_LR", state.__lr);
+    faultHex("FAULT_SP", state.__sp);
+    faultHex("FAULT_FP", state.__fp);
+    faultHex("FAULT_ADDRESS", reinterpret_cast<unsigned long long>(info->si_addr));
+    for (int i = 0; i < 29; ++i) {
+        char key[] = "FAULT_X00";
+        key[7] = '0' + i / 10; key[8] = '0' + i % 10;
+        faultHex(key, state.__x[i]);
+    }
+
+}
+#endif

 bool CrashHandler::hasCrashed = false;

