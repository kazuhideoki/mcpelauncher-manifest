+#include <cstring>
+static uintptr_t personaDiagnosticBase;
+static void* personaDiagnosticObject;
+static void* personaDiagnosticGraphics;
+static void personaDiagnosticRelease(void* object, const void* name) {
+    auto words = static_cast<uintptr_t*>(object);
+    if (object != personaDiagnosticObject || words[1] != reinterpret_cast<uintptr_t>(personaDiagnosticGraphics)) {
+        fprintf(stderr, "[PersonaDiagnostic] RELEASE MISMATCH provider=%p graphics=%p expectedProvider=%p expectedGraphics=%p\n", object, reinterpret_cast<void*>(words[1]), personaDiagnosticObject, personaDiagnosticGraphics);
+    }
+    reinterpret_cast<void(*)(void*, const void*)>(personaDiagnosticBase + 0xaaf72fc)(object, name);
+}
+static void personaDiagnosticDelete(void* object) {
+    fprintf(stderr, "[PersonaDiagnostic] DELETE provider=%p graphics=%p\n", object, reinterpret_cast<void**>(object)[1]);
+    reinterpret_cast<void(*)(void*)>(personaDiagnosticBase + 0xab0f634)(object);
+}
+static void* personaDiagnosticConstruct(void* object, void* graphics) {
+    auto words = static_cast<uintptr_t*>(object);
+    personaDiagnosticObject = object;
+    personaDiagnosticGraphics = graphics;
+    words[0] = personaDiagnosticBase + 0x12d0b7c8;
+    words[1] = reinterpret_cast<uintptr_t>(graphics);
+    fprintf(stderr, "[PersonaDiagnostic] provider=%p graphics=%p\n", object, graphics);
+    return object;
+}
+static void installPersonaDiagnostic(void* handle) {
+    if (!std::getenv("MCPELAUNCHER_DIAGNOSTIC_PERSONA")) return;
+    auto base = linker::get_library_base(handle);
+    fprintf(stderr, "[PersonaDiagnostic] base=%p\n", reinterpret_cast<void*>(base));
+    auto code = reinterpret_cast<void*>(base + 0xaaf6f60);
+    const uint32_t expected[] = {0xb00410a8, 0x911f2108, 0xa9000408, 0xd65f03c0};
